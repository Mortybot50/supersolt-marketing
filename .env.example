# SuperSolt marketing site — environment variables

# Plausible analytics (optional). If unset, the script tag is not rendered.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=supersolt.app

# Cal.com booking link (optional). When wired up later, uncomment and the
# DemoCTA placeholder can be replaced with the live booking flow.
# NEXT_PUBLIC_CAL_LINK=

# Resend (deliberately skipped this build per Gate 2 of the marketing site plan).
# RESEND_API_KEY=
